# Local stand-ins for the Worker's secrets, for `wrangler dev` only.
# Copy to .dev.vars (gitignored). `wrangler dev` can't see the real values: those
# are secrets set in the Cloudflare dashboard. See "Rebuilding the backend" in README.md.

# Shared key for POST /build. Locally it can be any string.
BUILD_INDEX_KEY=

# Shared key for POST /transcribe (the braggoscope pipeline sends it as a Bearer
# token; it lives in braggoscope's .env as TRANSCRIBE_KEY). Locally any string.
TRANSCRIBE_KEY=
